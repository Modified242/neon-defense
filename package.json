{
  "name": "tower-defense",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prestart": "vite build",
    "start": "electron .",
    "pack:mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.modified242.neondefense",
    "productName": "Neon Defense",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games"
    },
    "files": [
      "dist/**/*",
      "electron.js"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  }
}
